{
  "name": "claude-multi-launcher",
  "version": "1.0.0",
  "description": "Launcher for running several Claude Desktop accounts side by side on Windows and Linux",
  "author": "Sumant Sagar",
  "license": "MIT",
  "homepage": "https://github.com/SumantSagar73/claude-multi-launcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SumantSagar73/claude-multi-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/SumantSagar73/claude-multi-launcher/issues"
  },
  "keywords": [
    "claude",
    "claude-desktop",
    "windows",
    "linux",
    "multi-account",
    "launcher",
    "electron"
  ],
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "package": "node scripts/make-icon.js && electron-packager . \"Claude Multi Launcher\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=build/icon.ico --ignore=\"^/(dist|release|stage|test|scripts|build|spike-profile-a|.claude)($|/)\" --ignore=\"^/README.md$\"",
    "package:linux": "node scripts/make-icon.js && electron-packager . \"Claude Multi Launcher\" --platform=linux --arch=x64 --out=dist --overwrite --ignore=\"^/(dist|release|stage|test|scripts|build|spike-profile-a|.claude)($|/)\" --ignore=\"^/README.md$\"",
    "release": "node scripts/release.js",
    "install-app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall-app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall.ps1",
    "install-app:linux": "bash scripts/install.sh",
    "uninstall-app:linux": "bash scripts/uninstall.sh"
  },
  "build": {
    "appId": "com.multilauncher.claude",
    "productName": "Claude Multi Launcher",
    "artifactName": "Claude-Multi-Launcher-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Multi Launcher",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Several Claude Desktop accounts side by side",
      "artifactName": "Claude-Multi-Launcher-${version}-linux-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0"
  }
}
